{
  "expo": {
    "name": "Goldora",
    "slug": "goldloan-tracker-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "ios": {
      "icon": "./assets/Logo.png",
      "bundleIdentifier": "com.kishanth01.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kishanth01.myapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e55463a0-515b-4eec-bf4a-3cbaf909f485"
      }
    },
    "owner": "brewflocktechnologiess-team"
  }
